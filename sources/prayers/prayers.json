      "texts": {
        "el-male-rachamim": [
          {
            "role": "leader",
            "text": "אֵל מָלֵא רַחֲמִים"
          },
          {
            "role": "leader",
            "text": "שׁוֹכֵן בַּמְּרוֹמִים"
          },
          {
            "role": "leader",
            "text": "הַמְצֵא מְנוּחָה נְכוֹנָה"
          },
          {
            "role": "leader",
            "text": "עַל כַּנְפֵי הַשְּׁכִינָה"
          },
          {
            "role": "leader",
            "text": "בְּמַעֲלוֹת קְדוֹשִׁים וּטְהוֹרִים"
          },
          {
            "role": "leader",
            "text": "כְּזֹֽהַר הָרָקִֽיעַ מַזְהִירִים"
          },
          {
            "role": "leader",
            "text": "אֶת נִשְׁמַת"
          },
          {
            "role": "leader",
            "text": "(פב\"פ)",
            "slot": "name"
          },
          {
            "role": "leader",
            "text": "שֶׁהָלַךְ לְעוֹלָמוֹ"
          },
          {
            "role": "leader",
            "text": "בַּעֲבוּר שֶׁנָּדְבוּ צְדָקָה"
          },
          {
            "role": "leader",
            "text": "בְּעַד הַזְכָּרַת נִשְׁמָתוֹ"
          },
          {
            "role": "leader",
            "text": "בְּגַן עֵֽדֶן"
          },
          {
            "role": "leader",
            "text": "תְּהֵא מְנוּחָתוֹ"
          },
          {
            "role": "leader",
            "text": "לָכֵן בַּֽעַל הָרַחֲמִים"
          },
          {
            "role": "leader",
            "text": "יַסְתִּירֵֽהוּ"
          },
          {
            "role": "leader",
            "text": "בְּסֵֽתֶר כְּנָפָיו לְעוֹלָמִים"
          },
          {
            "role": "leader",
            "text": "וְיִצְרוֹר"
          },
          {
            "role": "leader",
            "text": "בִּצְרוֹר הַחַיִּים אֶת נִשְׁמָתוֹ"
          },
          {
            "role": "leader",
            "text": "יְהֹוָה הוּא נַחֲלָתוֹ"
          },
          {
            "role": "leader",
            "text": "וְיָנֽוּחַ עַל מִשְׁכָּבוֹ בְּשָׁלוֹם"
          },
          {
            "role": "leader",
            "text": "וְנֹאמַר אָמֵן:"
          }
        ],
