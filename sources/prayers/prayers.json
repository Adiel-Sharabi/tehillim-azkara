        "kaddish-yatom": [
          {
            "role": "leader",
            "text": "יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא."
          },
          {
            "role": "congregation",
            "text": "אמן"
          },
          {
            "role": "leader",
            "text": "בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ וְיַמְלִיךְ מַלְכוּתֵהּ בְּחַיֵּיכון וּבְיומֵיכון וּבְחַיֵּי דְכָל בֵּית יִשרָאֵל בַּעֲגָלָא וּבִזְמַן קָרִיב, וְאִמְרוּ אָמֵן:"
          },
          {
            "role": "congregation",
            "text": "אמן"
          },
          {
            "role": "congregation",
            "text": "יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא:",
            "together": true
          },
          {
            "role": "leader",
            "text": "יִתְבָּרַךְ וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרומַם וְיִתְנַשּא וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל שְׁמֵהּ דְּקֻדְשָׁא. בְּרִיךְ הוּא."
          },
          {
            "role": "congregation",
            "text": "בריך הוא:"
          },
          {
            "role": "leader",
            "text": "לְעֵלָּא מִן כָּל בִּרְכָתָא"
          },
          {
            "role": "instruction",
            "text": "בעשי”ת: לְעֵלָּא לְעֵלָּא מִכָּל"
          },
          {
            "role": "leader",
            "text": "וְשִׁירָתָא תֻּשְׁבְּחָתָא וְנֶחֱמָתָא דַּאֲמִירָן בְּעָלְמָא. וְאִמְרוּ אָמֵן:"
          },
          {
            "role": "congregation",
            "text": "אמן"
          },
          {
            "role": "leader",
            "text": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא וְחַיִּים עָלֵינוּ וְעַל כָּל יִשרָאֵל. וְאִמְרוּ אָמֵן:"
          },
          {
            "role": "congregation",
            "text": "אמן"
          },
          {
            "role": "leader",
            "text": "עוֹשה שָׁלוֹם"
          },
          {
            "role": "instruction",
            "text": "בעשי”ת: הַשָּׁלום"
          },
          {
            "role": "leader",
            "text": "בִּמְרומָיו הוּא יַעֲשה שָׁלום עָלֵינוּ וְעַל כָּל יִשרָאֵל וְאִמְרוּ אָמֵן:"
          },
          {
            "role": "congregation",
            "text": "אמן"
          }
        ],
        "kaddish-derabbanan": [
          {
            "role": "leader",
            "text": "יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא."
          },
